    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: download-data\n",
        "#| code-summary: Download IMD rainfall data (1965–2025)\n",
        "\n",
        "import imdlib as imd\n",
        "\n",
        "start_yr = 1965\n",
        "end_yr   = 2025\n",
        "\n",
        "data = imd.get_data(\n",
        "    var_type  = 'rain',       # 'rain', 'tmax', or 'tmin'\n",
        "    start_yr  = start_yr,\n",
        "    end_yr    = end_yr,\n",
        "    fn_format = 'yearwise',   # one .grd file per year\n",
        "    file_dir  = './data/imd_rain/'\n",
        ")\n",
        "\n",
        "print(\"✅ Download complete.\")\n",
        "print(data)"
      ],
      "id": "download-data",
      "execution_count": null,
      "outputs": []
    },
