      "source": [
        "#| echo: false\n",
        "#| output: asis\n",
        "import csv, os\n",
        "from IPython.display import HTML, display\n",
        "\n",
        "# ── CSV path — absolute based on project root ───────────────────\n",
        "CSV_PATH = os.path.join(os.getcwd(), \"data\", \"publications.csv\")\n",
        "\n",
        "# ── Tag colour mapping ──────────────────────────────────────────\n",
        "GREEN = {\"Geospatial\",\"Google Earth Engine\",\"Soil Carbon\",\"Coastal Agronomy\",\n",
        "         \"Conservation Agriculture\",\"Soil Health\",\"Rice Farming\",\"Soil Quality\",\n",
        "         \"Agroforestry\",\"Organic Farming\",\"Agronomy\",\"Oat Production\",\n",
        "         \"Varietal Selection\",\"Maize\",\"Nutrient Management\",\"Dryland Agriculture\",\n",
        "         \"Maize Root Growth\",\"Potassium\",\"Zinc\",\"Zinc Nutrition\",\"Zinc Fertilization\",\n",
        "         \"Silicon\",\"Wheat Yield\",\"Soil Fertility\",\"Tillage\",\"Conservation Tillage\",\n",
        "         \"Rice Varieties\",\"Phytochemicals\",\"Rice-Wheat System\",\"High-Altitude Agriculture\",\n",
        "         \"PGPR\",\"Sustainable Agriculture\",\"Microbial Stimulants\",\"Abiotic Stress\",\n",
        "         \"Medicinal Crops\",\"Moisture Stress\",\"Microbial Synergy\",\"Natural Farming\",\n",
        "         \"Rice Pest\",\"North-East India\",\"Cotton\",\"Sulphur Nutrition\",\"Rainfed Agriculture\",\n",
        "         \"Nutrient Quality\",\"Crop Economics\",\"Legumes\",\"Green Technology\",\"Cropping Patterns\"}\n",
        "AMBER = {\"Fodder Quality\",\"Nitrate Toxicity\",\"Fodder Oats\",\"Livestock Systems\",\n",
        "         \"Fodder Crops\",\"Livestock Feed\",\"Fodder Maize\",\"Fodder Production\",\n",
        "         \"Mycorrhizal Fungi\",\"Forage Crops\"}\n",
        "PURPLE = {\"Bibliometrics\",\"Computational Intelligence\",\"Nanobionics\",\n",
        "          \"Nanotechnology\",\"Biofortification\",\"Nutrition\"}\n",
        "\n",
        "def tag_cls(t):\n",
        "    t = t.strip()\n",
        "    if t in GREEN:  return \"ptag-green\"\n",
        "    if t in AMBER:  return \"ptag-amber\"\n",
        "    if t in PURPLE: return \"ptag-purple\"\n",
        "    return \"ptag-blue\"\n",
        "\n",
        "def make_tags(tags_str, sdg_str):\n",
        "    h = \"\"\n",
        "    for t in (tags_str or \"\").split(\"|\"):\n",
        "        t = t.strip()\n",
        "        if t: h += f'<span class=\"ptag {tag_cls(t)}\">{t}</span>'\n",
        "    for s in (sdg_str or \"\").split(\"|\"):\n",
        "        s = s.strip()\n",
        "        if s: h += f'<span class=\"ptag ptag-sdg\">{s}</span>'\n",
        "    return h\n",
        "\n",
        "def pub_card(r):\n",
        "    year      = r.get(\"year\",\"\")\n",
        "    ptype     = r.get(\"type\",\"journal\").strip().capitalize()\n",
        "    title     = r.get(\"title\",\"\")\n",
        "    journal   = r.get(\"journal\",\"\")\n",
        "    publisher = r.get(\"publisher\",\"\")\n",
        "    authors   = r.get(\"authors\",\"\")\n",
        "    note      = r.get(\"note\",\"\")\n",
        "    link      = r.get(\"link\",\"\").strip()\n",
        "    doi       = r.get(\"doi\",\"\").strip()\n",
        "\n",
        "    meta = f'<span class=\"pub-journal\">{journal}</span>'\n",
        "    if publisher: meta += f'<span class=\"pub-sep\">&middot;</span><span>{publisher}</span>'\n",
        "    if authors:   meta += f'<span class=\"pub-sep\">&middot;</span><span class=\"pub-authors\">{authors}</span>'\n",
        "\n",
        "    note_h  = f'<div class=\"pub-note\">{note}</div>' if note else \"\"\n",
        "    links_h = \"\"\n",
        "    if link or doi:\n",
        "        links_h = '<div class=\"pub-links\">'\n",
        "        if link: links_h += f'<a class=\"plink plink-dark\" href=\"{link}\" target=\"_blank\">Read Paper</a>'\n",
        "        if doi:  links_h += f'<a class=\"plink plink-outline\" href=\"{doi}\" target=\"_blank\">DOI</a>'\n",
        "        links_h += '</div>'\n",
        "\n",
        "    return f\"\"\"<div class=\"pub-card\">\n",
        "  <div class=\"pub-left\"><div class=\"pub-year-badge\">{year}</div><div class=\"pub-type-label\">{ptype}</div></div>\n",
        "  <div>\n",
        "    <div class=\"pub-title\">{title}</div>\n",
        "    <div class=\"pub-meta\">{meta}</div>\n",
        "    <div class=\"pub-tags\">{make_tags(r.get(\"tags\",\"\"), r.get(\"sdg_tags\",\"\"))}</div>\n",
        "    {note_h}{links_h}\n",
        "  </div>\n",
        "</div>\"\"\"\n",
        "\n",
        "# ── Read CSV ────────────────────────────────────────────────────\n",
        "rows = []\n",
        "if os.path.exists(CSV_PATH):\n",
        "    with open(CSV_PATH, newline='', encoding='utf-8') as f:\n",
        "        rows = list(csv.DictReader(f))\n",
        "\n",
        "journals = [r for r in rows if r.get(\"type\",\"\").strip().lower() == \"journal\"]\n",
        "chapters = [r for r in rows if r.get(\"type\",\"\").strip().lower() == \"chapter\"]\n",
        "\n",
        "# ── Build page HTML ─────────────────────────────────────────────\n",
        "parts = []\n",
        "\n",
        "parts.append(\"\"\"<style>\n",
        ".ptag-sdg{background:#0D2137;color:#5DCAA5;font-weight:700;border:1px solid #1D9E75;}\n",
        "</style>\n",
        "\n",
        "<div class=\"rp-header\"><div class=\"rp-header-inner\">\n",
        "  <div class=\"rp-label\">Publications &amp; Research Output</div>\n",
        "  <div class=\"rp-title\">Research</div>\n",
        "  <div class=\"rp-stats\">\n",
        "    <div class=\"rp-stat\"><div class=\"rp-snum\">60+</div><div class=\"rp-slbl\">Papers</div></div>\n",
        "    <div class=\"rp-stat\"><div class=\"rp-snum\">15+</div><div class=\"rp-slbl\">Journals</div></div>\n",
        "    <div class=\"rp-stat\"><div class=\"rp-snum\" id=\"rp-citations\">324</div><div class=\"rp-slbl\">Total Citations</div></div>\n",
        "    <div class=\"rp-stat\"><div class=\"rp-snum\" id=\"rp-hindex\">9</div><div class=\"rp-slbl\">h-index</div></div>\n",
        "    <div class=\"rp-stat\"><div class=\"rp-snum\">2017&ndash;2026</div><div class=\"rp-slbl\">Publication Span</div></div>\n",
        "  </div>\n",
        "</div></div>\n",
        "<script>\n",
        "fetch('/data/citations.json')\n",
        "  .then(function(r){return r.json();})\n",
        "  .then(function(d){\n",
        "    document.getElementById('rp-citations').textContent=d.citations_total;\n",
        "    document.getElementById('rp-hindex').textContent=d.h_index;\n",
        "  }).catch(function(){});\n",
        "</script>\"\"\")\n",
        "\n",
        "parts.append(f\"\"\"\n",
        "<div class=\"rp-nav\"><div class=\"rp-nav-inner\">\n",
        "  <a href=\"#journal-articles\">Journal Articles <span class=\"rp-nav-count\">{len(journals)}</span></a>\n",
        "  <a href=\"#book-chapters\">Book Chapters <span class=\"rp-nav-count\">{len(chapters)}</span></a>\n",
        "  <a href=\"#phd-thesis\">PhD Thesis</a>\n",
        "  <a href=\"#ongoing-research\">Ongoing Research</a>\n",
        "</div></div>\n",
        "\n",
        "<div class=\"rp-body\"><div class=\"rp-body-inner\">\n",
        "\n",
        "<div class=\"rp-legend\">\n",
        "  <div class=\"rp-legend-title\">Tag colours:</div>\n",
        "  <div class=\"rp-legend-item\"><div class=\"rp-legend-dot\" style=\"background:#085041;\"></div>Geospatial &amp; Agronomy</div>\n",
        "  <div class=\"rp-legend-item\"><div class=\"rp-legend-dot\" style=\"background:#0C447C;\"></div>Climate &amp; Policy</div>\n",
        "  <div class=\"rp-legend-item\"><div class=\"rp-legend-dot\" style=\"background:#633806;\"></div>Fodder &amp; Livestock</div>\n",
        "  <div class=\"rp-legend-item\"><div class=\"rp-legend-dot\" style=\"background:#3C3489;\"></div>Bibliometrics &amp; Technology</div>\n",
        "  <div class=\"rp-legend-item\"><div class=\"rp-legend-dot\" style=\"background:#1D9E75;\"></div>SDG Alignment</div>\n",
        "</div>\"\"\")\n",
        "\n",
        "# Journal Articles\n",
        "parts.append(f\"\"\"\n",
        "<div class=\"rp-sec-header\" id=\"journal-articles\">\n",
        "  <div class=\"rp-sec-title\">Journal Articles</div>\n",
        "  <div class=\"rp-sec-count\">{len(journals)} papers</div>\n",
        "  <div class=\"rp-sec-line\"></div>\n",
        "</div>\"\"\")\n",
        "for r in journals:\n",
        "    parts.append(pub_card(r))\n",
        "\n",
        "# Book Chapters\n",
        "parts.append(f\"\"\"\n",
        "<div class=\"rp-sec-header\" id=\"book-chapters\">\n",
        "  <div class=\"rp-sec-title\">Book Chapters</div>\n",
        "  <div class=\"rp-sec-count\">{len(chapters)} chapters</div>\n",
        "  <div class=\"rp-sec-line\"></div>\n",
        "</div>\"\"\")\n",
        "for r in chapters:\n",
        "    parts.append(pub_card(r))\n",
        "\n",
        "# PhD Thesis\n",
        "parts.append(\"\"\"\n",
        "<div class=\"rp-sec-header\" id=\"phd-thesis\">\n",
        "  <div class=\"rp-sec-title\">PhD Thesis</div>\n",
        "  <div class=\"rp-sec-line\"></div>\n",
        "</div>\n",
        "<div class=\"thesis-card\">\n",
        "  <div style=\"display:flex;align-items:flex-start;gap:16px;\">\n",
        "    <div style=\"flex-shrink:0;\">\n",
        "      <div class=\"pub-year-badge\" style=\"width:52px;\">2023</div>\n",
        "      <div class=\"pub-type-label\">PhD</div>\n",
        "    </div>\n",
        "    <div>\n",
        "      <div class=\"thesis-title\">Performance of Wheat&ndash;Maize&ndash;Cowpea Cropping Sequence Under Continuous Use of Municipal Solid Waste Compost</div>\n",
        "      <div class=\"thesis-meta\">ICAR &ndash; National Dairy Research Institute, Karnal, Haryana &nbsp;&middot;&nbsp; Doctoral Dissertation</div>\n",
        "      <div class=\"pub-tags\" style=\"margin-bottom:8px;\">\n",
        "        <span class=\"ptag ptag-green\">Cropping Systems</span>\n",
        "        <span class=\"ptag ptag-blue\">MSW Compost</span>\n",
        "        <span class=\"ptag ptag-green\">Soil Health</span>\n",
        "        <span class=\"ptag ptag-amber\">Carbon Cycling</span>\n",
        "        <span class=\"ptag ptag-sdg\">SDG 2</span>\n",
        "        <span class=\"ptag ptag-sdg\">SDG 12</span>\n",
        "        <span class=\"ptag ptag-sdg\">SDG 15</span>\n",
        "      </div>\n",
        "      <div class=\"thesis-note\">Doctoral research examining how continuous application of municipal solid waste compost affects productivity and soil quality in wheat&ndash;maize&ndash;cowpea cropping sequences. Established foundational knowledge on organic waste recycling in agriculture &mdash; contributing to both soil health and circular economy goals.</div>\n",
        "    </div>\n",
        "  </div>\n",
        "</div>\"\"\")\n",
        "\n",
        "# Ongoing Research\n",
        "parts.append(\"\"\"\n",
        "<div class=\"rp-sec-header\" id=\"ongoing-research\">\n",
        "  <div class=\"rp-sec-title\">Ongoing Research</div>\n",
        "  <div class=\"rp-sec-line\"></div>\n",
        "</div>\n",
        "<div class=\"ongoing-card\">\n",
        "  <div class=\"ongoing-item\">\n",
        "    <div class=\"ongoing-dot\"></div>\n",
        "    <div>Geospatial assessment of coastal agricultural vulnerability using Google Earth Engine and multi-temporal remote sensing data</div>\n",
        "  </div>\n",
        "  <div class=\"ongoing-item\">\n",
        "    <div class=\"ongoing-dot\"></div>\n",
        "    <div>Soil health monitoring in rice-based cropping systems of coastal Goa &mdash; seasonal dynamics of biological and chemical indicators</div>\n",
        "  </div>\n",
        "  <div class=\"ongoing-item\">\n",
        "    <div class=\"ongoing-dot\"></div>\n",
        "    <div>Climate adaptation strategies for coastal farming communities in Goa &mdash; participatory assessment and policy framework development</div>\n",
        "  </div>\n",
        "</div>\n",
        "\n",
        "</div></div>\"\"\")\n",
        "\n",
        "display(HTML(\"\\n\".join(parts)))"
      ],
