: 12px; margin-bottom: 10px;\n}\n.sb-sw-icon { font-size: 1.8rem; flex-shrink: 0; }\n.sb-sw-name { font-size: 1.05rem; font-weight: 700; color: #0D2137; margin-bottom: 4px; }\n.sb-sw-badges { display: flex; gap: 5px; flex-wrap: wrap; }\n.sb-sw-badge {\n  font-size: 0.58rem; font-weight: 700; padding: 2px 7px;\n  border-radius: 20px; text-transform: uppercase; letter-spacing: 0.06em;\n}\n.sb-sw-badge-cran  { background: #1565C0; color: white; }\n.sb-sw-badge-r     { background: #E1F5EE; color: #085041; }\n.sb-sw-badge-mit   { background: #f0efea; color: #666; }\n.sb-sw-btn {\n  margin-left: auto; background: #0D2137; color: #5DCAA5 !important;\n  border: 1px solid #1D9E75; padding: 6px 14px; border-radius: 5px;\n  font-size: 0.75rem; font-weight: 600; text-decoration: none !important;\n  white-space: nowrap; transition: all 0.18s; flex-shrink: 0;\n}\n.sb-sw-btn:hover { background: #1D9E75; color: white !important; }\n.sb-sw-desc {\n  font-size: 0.82rem; color: #555; line-height: 1.65; margin-bottom: 12px;\n}\n.sb-sw-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }\n.sb-sw-tags { display: flex; flex-wrap: wrap; gap: 5px; }\n.sb-sw-links { display: flex; gap: 8px; flex-shrink: 0; }\n.sb-sw-link {\n  font-size: 0.72rem; font-weight: 600; color: #1D9E75 !important;\n  text-decoration: none; border-bottom: 1px solid rgba(29,158,117,0.3);\n  padding-bottom: 1px; transition: border-color 0.15s;\n}\n.sb-sw-link:hover { border-color: #1D9E75; }\n\n/* ── Publication title links ── */\n.sb-ptitle a { color: #0D2137 !important; text-decoration: none !important; font-weight: 600; }\n.sb-ptitle a:hover { color: #1D9E75 !important; text-decoration: underline !important; }\n\n/* ── imdR hero button ── */\n.sb-btn-green { background: #1D9E75 !important; color: white !important; border: none !important; }\n.sb-btn-green:hover { background: #178c66 !important; color: white !important; }\n</style>\n```\n"},"formats":{"html":{"ide